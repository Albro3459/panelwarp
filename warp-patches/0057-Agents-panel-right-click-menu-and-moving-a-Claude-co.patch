     /// Searches this workspace's tabs for the given terminal view and focuses it.
     /// Returns true if the terminal view was found and focused.
+    /// Moves the Claude Code conversation running in a pane to the host's Claude Code extension:
+    /// Ctrl+C until the CLI has exited (one interrupts a running turn, two more quit), so the
+    /// conversation is never written by two at once, then the host opens it in its editor tab.
+    /// The pane's shell stays.
+    fn move_agent_conversation_to_host(
+        &mut self,
+        terminal_view_id: EntityId,
+        ctx: &mut ViewContext<Self>,
+    ) {
+        let Some(session_id) = claude_session_id(terminal_view_id, ctx) else {
+            return;
+        };
+        let terminal_view = self.tabs.iter().find_map(|tab| {
+            let pane_group = tab.pane_group.as_ref(ctx);
+            pane_group
+                .find_pane_id_for_terminal_view(terminal_view_id, ctx)
+                .and_then(|pane_id| pane_group.terminal_view_from_pane_id(pane_id, ctx))
+        });
+        let Some(terminal_view) = terminal_view else {
+            return;
+        };
+        Self::stop_agent_then_open_in_host(terminal_view, session_id, 10, ctx);
+    }
+
+    fn stop_agent_then_open_in_host(
+        terminal_view: ViewHandle<TerminalView>,
+        session_id: String,
+        attempts_left: u32,
+        ctx: &mut ViewContext<Self>,
+    ) {
+        let running = claude_session_id(terminal_view.id(), ctx).as_deref() == Some(&session_id);
+        if !running || attempts_left == 0 {
+            #[cfg(target_family = "wasm")]
+            ctx.spawn(
+                async move {
+                    crate::platform::wasm::open_agent_conversation_in_host(
+                        "claude",
+                        &session_id,
+                        "editor",
+                    )
+                    .await
+                },
+                |_, _, _| {},
+            );
+            return;
+        }
+        terminal_view.update(ctx, |view, ctx| {
+            view.write_user_bytes_to_pty(vec![crate::terminal::model::escape_sequences::C0::ETX], ctx);
+        });
+        ctx.spawn(Timer::after(Duration::from_millis(400)), move |_, _, ctx| {
+            Self::stop_agent_then_open_in_host(terminal_view, session_id, attempts_left - 1, ctx);
+        });
+    }
