+    /// Embedded builds: "Move to Claude Code extension" for a pane running a Claude Code
+    /// conversation Warp's plugin knows the id of.
+    fn agent_menu_items(
+        &self,
+        pane_name_target: Option<PaneNameMenuTarget>,
+        ctx: &AppContext,
+    ) -> Vec<MenuItem<WorkspaceAction>> {
+        if !cfg!(feature = "remote_tty") {
+            return vec![];
+        }
+        let pane_group = self.pane_group.as_ref(ctx);
+        let terminal_view = pane_name_target
+            .filter(|target| self.pane_group.id() == target.locator.pane_group_id)
+            .and_then(|target| pane_group.terminal_view_from_pane_id(target.locator.pane_id, ctx))
+            .or_else(|| pane_group.focused_session_view(ctx));
+        let Some(terminal_view_id) = terminal_view.map(|view| view.id()) else {
+            return vec![];
+        };
+        if crate::workspace::view::agent_conversations::claude_session_id(terminal_view_id, ctx)
+            .is_none()
+        {
+            return vec![];
+        }
+        vec![
+            MenuItemFields::new("Move to Claude Code extension")
+                .with_on_select_action(WorkspaceAction::MoveAgentConversationToHost {
+                    terminal_view_id,
+                })
+                .into_item(),
+        ]
+    }
