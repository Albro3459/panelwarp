diff --git a/app/src/terminal/cli_agent_sessions/mod.rs b/app/src/terminal/cli_agent_sessions/mod.rs
index 7b44cf7..f4c69c8 100644
--- a/app/src/terminal/cli_agent_sessions/mod.rs
+++ b/app/src/terminal/cli_agent_sessions/mod.rs
@@ -258,10 +258,26 @@ impl CLIAgentSession {
                 CLIAgentSessionStatus::InProgress
             }
             // IdlePrompt means the agent is sitting at its prompt waiting for input.
-            // This should not affect status — otherwise it would override Success after a Stop event.
-            CLIAgentEventType::IdlePrompt => return None,
+            // It must not override Success after a Stop event, but a turn still marked
+            // InProgress has ended without a Stop: Claude Code fires no hook when the
+            // user interrupts it with Esc, so without this the tab stays "in progress".
+            // Changed quietly (no `StatusChanged`): the user ended the turn, so it
+            // shouldn't notify like a finished task.
+            CLIAgentEventType::IdlePrompt => {
+                if matches!(self.status, CLIAgentSessionStatus::InProgress) {
+                    self.status = CLIAgentSessionStatus::Cancelled;
+                }
+                return None;
+            }
+            // The agent just started (or resumed) and waits for its first prompt. The session
+            // was registered optimistically as InProgress when the command was detected, so
+            // without this a freshly started or resumed agent shows "in progress" while idle.
+            // Quietly too: nothing finished.
             CLIAgentEventType::SessionStart => {
                 self.plugin_version = event.payload.plugin_version.clone();
+                if matches!(self.status, CLIAgentSessionStatus::InProgress) {
+                    self.status = CLIAgentSessionStatus::Success;
+                }
                 return None;
             }
             CLIAgentEventType::Unknown(_) => return None,
@@ -517,7 +533,11 @@ impl CLIAgentSessionsModel {
         }
 
         let event_type = &event.event;
-        if let Some(new_status) = session.apply_event(event) {
+        let status_before = session.status.clone();
+        let new_status = session.apply_event(event);
+        // A status set without `StatusChanged` (see `apply_event`) still has to re-render.
+        let changed_quietly = new_status.is_none() && session.status != status_before;
+        if let Some(new_status) = new_status {
             let agent = session.agent;
             ctx.emit(CLIAgentSessionsModelEvent::StatusChanged {
                 terminal_view_id,
@@ -528,12 +548,14 @@ impl CLIAgentSessionsModel {
             });
         }
 
-        if matches!(
-            event_type,
-            CLIAgentEventType::SessionStart
-                | CLIAgentEventType::PromptSubmit
-                | CLIAgentEventType::ToolComplete
