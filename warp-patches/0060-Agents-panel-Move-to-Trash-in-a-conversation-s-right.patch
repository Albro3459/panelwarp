+    /// Moves the conversation's session file to the Trash.
+    Trash(usize),
 }
 
 pub enum AgentConversationsEvent {
@@ -449,6 +451,15 @@ impl AgentConversationsView {
                     ))
                     .into_item(),
             );
+            // Not while a turn runs: the agent would write the file again.
+            if conversation.status.as_deref() != Some("working") {
+                items.push(MenuItem::Separator);
+                items.push(
