+                        .with_on_select_action(AgentConversationsAction::Trash(index))
+                        .into_item(),
+                );
+            }
         }
         self.set_hovered_index(None, ctx);
         self.summary_index = None;
@@ -460,6 +471,35 @@ impl AgentConversationsView {
         ctx.notify();
     }
 
+    /// Moves a conversation's session file to the Trash through the host. Its row goes right away;
+    /// the next list from the host brings it back if that failed.
+    fn trash(&mut self, index: usize, ctx: &mut ViewContext<Self>) {
+        self.context_menu_position = None;
+        let Some(conversation) = self.conversations.get(index) else {
+            return;
+        };
+        let (agent, id) = (conversation.agent.clone(), conversation.id.clone());
+        self.host_conversations
+            .retain(|row| !(row.agent == agent && row.id == id));
+        self.summary_index = None;
+        self.rebuild_rows(ctx);
+        #[cfg(target_family = "wasm")]
+        ctx.spawn(
+            async move {
+                crate::platform::wasm::trash_agent_conversation_in_host(&agent, &id).await
+            },
+            |me, result, ctx| {
+                if let Err(error) = result {
+                    log::warn!("Couldn't move the conversation to the Trash: {error}");
+                }
+                me.last_json = None;
+                me.refresh(ctx);
+            },
+        );
+        #[cfg(not(target_family = "wasm"))]
+        let _ = (agent, id);
+    }
+
     fn open(&mut self, index: usize, target: OpenTarget, ctx: &mut ViewContext<Self>) {
         self.context_menu_position = None;
         let Some(conversation) = self.conversations.get_mut(index) else {
@@ -520,6 +560,7 @@ impl TypedActionView for AgentConversationsView {
             AgentConversationsAction::OpenContextMenu { index, position } => {
                 self.open_context_menu(*index, *position, ctx)
             }
+            AgentConversationsAction::Trash(index) => self.trash(*index, ctx),
             AgentConversationsAction::MoveToHost(terminal_view_id) => {
                 self.context_menu_position = None;
                 ctx.emit(AgentConversationsEvent::MoveToHost(*terminal_view_id));
