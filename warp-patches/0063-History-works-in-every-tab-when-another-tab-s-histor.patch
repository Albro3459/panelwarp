+#[test]
+fn stuck_history_file_read_does_not_block_other_sessions() {
+    App::test((), |mut app| async move {
+        let session_a = Arc::new(Session::new(
+            SessionInfo::new_for_test()
+                .with_id(0)
+                .with_shell_type(ShellType::Zsh),
+            Arc::new(TestCommandExecutor::default()),
+        ));
+        let session_b = Arc::new(Session::new(
+            SessionInfo::new_for_test()
+                .with_id(1)
+                .with_shell_type(ShellType::Zsh),
+            Arc::new(TestCommandExecutor::default()),
+        ));
+        let (session_a_id, session_b_id) = (session_a.id(), session_b.id());
+        let (tx, rx) = async_channel::bounded::<()>(1);
+
+        let mut history_handle = app.add_model(|_| History::default());
+        history_handle.update(&mut app, move |history, ctx| {
+            // Session A's read hangs until `tx` sends.
+            history.init_session_with(
+                session_a,
+                async move {
+                    pin!(rx).next().await;
+                    vec!["late".to_string()]
+                },
+                ctx,
+            );
+            history.init_session_with(session_b, async { vec!["z1".to_string()] }, ctx);
+        });
+        History::initialized_sessions(
+            &mut history_handle,
+            &mut app,
+            vec![session_a_id, session_b_id],
+        )
+        .await;
+
+        history_handle.update(&mut app, |history, _| {
+            history.append_commands(
+                session_b_id,
+                vec![HistoryEntry::with_session_id(session_b_id, "z2")],
+            );
+        });
+        history_handle.read(&app, |history, _| {
+            assert_eq!(history.len(session_a_id), 1);
+            assert_eq!(history.len(session_b_id), 2);
+        });
+
+        // Session A's read finishing later doesn't replace the loaded history.
+        tx.send(()).await.unwrap();
+        history_handle.update(&mut app, |_, _| {});
+        history_handle.read(&app, |history, _| {
+            assert_eq!(history.len(session_b_id), 2);
+        });
+    });
+}
